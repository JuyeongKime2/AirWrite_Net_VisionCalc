# 이 파일을 복사해 .streamlit/secrets.toml 로 저장하면 내 PC에서 쓰입니다 (GitHub에는 안 올라감).
# Streamlit Cloud에서는 앱 설정 > Secrets 칸에 같은 내용을 붙여 넣으세요.
#
# 회사·학교망처럼 방화벽이 있는 곳에서 카메라 연결이 안 될 때만 필요합니다.
# 아무것도 없으면 공개 STUN 서버만 사용합니다.

# 방법 1: Cloudflare TURN (무료 사용량 있음, 권장)
# Cloudflare 대시보드 > Realtime > TURN 에서 키를 만들면 나오는 두 값
# CLOUDFLARE_TURN_KEY_ID = "..."
# CLOUDFLARE_TURN_KEY_API_TOKEN = "..."

# 방법 2: 다른 TURN 서버 정보를 직접 넣기 (JSON 문자열)
# ICE_SERVERS = '[{"urls": ["turn:example.com:3478"], "username": "user", "credential": "pass"}]'
